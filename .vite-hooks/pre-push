#!/usr/bin/env sh
# Nothing private leaves this Mac: each pushed range must pass
# stemcells/scripts/publishable (stemcells/AGENTS.md, In public).
zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  base=$remote_sha
  git cat-file -e "$base^{commit}" 2> /dev/null || base=origin/main
  stemcells/scripts/publishable "$base" "$local_sha" || exit 1
done
