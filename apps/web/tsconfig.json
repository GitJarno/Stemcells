{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "erasableSyntaxOnly": false,
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "lib": ["ES2023", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "paths": {
      "~/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        // Diagnostic severities are deep-merged with tsconfig.base.json; list only web-specific overrides here.
        "diagnosticSeverity": {
          "globalDate": "off",
          "globalConsole": "off",
          "globalRandom": "off",
          "globalTimers": "off",
          "globalFetch": "off"
        }
      }
    ]
  },
  "include": [
    "src",
    "vite",
    "vite.config.ts",
    "vercel.ts",
    "gt.config.json",
    "test",
    "scripts/verify-built-boot.ts",
    "scripts/warm-dep-cache.ts",
    "../../scripts/lib/public-config.ts",
    "../../scripts/lib/third-party-licenses.ts",
    "../../scripts/lib/brand-assets.ts",
    "../../stemcells/boundary/check.ts",
    "../../stemcells/brand/assets.ts",
    "../../stemcells/brand/look.ts",
    "../../stemcells/brand/mark.ts",
    "../../stemcells/brand/name.ts",
    "../../stemcells/brand/nameTransform.ts",
    "../../stemcells/brand/upstreamName.ts",
    "../../stemcells/brand/wordTable.ts",
    "../../stemcells/chart/layout.ts",
    "../../stemcells/chart/parse.ts",
    "../../stemcells/closeOut/closeOut.ts",
    "../../stemcells/closeOut/preread.ts",
    "../../stemcells/disk/notice.ts",
    "../../stemcells/disk/project.ts",
    "../../stemcells/ledger/alone.ts",
    "../../stemcells/ledger/facts.ts",
    "../../stemcells/ledger/marks.ts",
    "../../stemcells/words/casualChat.ts",
    "../../stemcells/words/cellMail.ts",
    "../../stemcells/words/cellNames.ts",
    "../../stemcells/words/cellTools.ts",
    "../../stemcells/words/cells.ts",
    "../../stemcells/words/closeOut.ts",
    "../../stemcells/words/copyCell.ts",
    "../../stemcells/words/disk.ts",
    "../../stemcells/words/marks.ts",
    "../../stemcells/words/subcells.ts"
  ]
}
