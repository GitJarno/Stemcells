#!/usr/bin/env bash
# Draws, checks and lays out Cell art with no dev server: the kit and the
# art drawn beside it, run by node's own TypeScript. stemcells/docs/cell-art.md
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
exec node --disable-warning=ExperimentalWarning apps/web/src/stemcells/cell/tools/cells.ts "$@"
