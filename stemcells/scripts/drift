#!/usr/bin/env bash
# Lists every upstream file this fork changes and fails on one that
# stemcells/seams.md doesn't name, or on a seam row naming a file that no
# longer differs from upstream. Our own folders are never drift.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

git rev-parse -q --verify upstream/main >/dev/null || {
  echo "drift: no upstream/main; run: git remote add upstream https://github.com/pingdotgg/t3code.git && git fetch upstream" >&2
  exit 2
}
base=$(git merge-base HEAD upstream/main)
ours='^(stemcells/|apps/(web|server|mobile)/src/stemcells/|packages/stemcells-)'

changed=$({ git diff --name-only "$base"; git ls-files --others --exclude-standard; } \
  | sort -u | grep -Ev "$ours" || true)

# Over this, upstream edits the file about every day: its seams get a
# substitute or an extension point before a feature touches the file again
# (stemcells/docs/fork.md, rule 7).
HOT=90

echo "        heat = upstream commits in 90 days; hot = over $HOT"
unlisted=0
hot=0
while IFS= read -r file; do
  [ -z "$file" ] && continue
  # Upstream commits touching the file in 90 days: a hot file is a poor seam.
  heat=$(git log --since=90.days --format=%h upstream/main -- "$file" | wc -l | tr -d ' ')
  if grep -qF "\`$file\`" stemcells/seams.md; then
    label=seam
    [ "$heat" -gt "$HOT" ] && label=hot && hot=$((hot + 1))
    printf '  %-4s  %4s  %s\n' "$label" "$heat" "$file"
  else
    printf '  DRIFT %4s  %s  (not in stemcells/seams.md)\n' "$heat" "$file"
    unlisted=1
  fi
done <<< "$changed"

# The other way round: a file a seam row names (its first column) that no
# longer differs from upstream. A sync makes these when upstream deletes a
# file we edited, or rewrites the lines our edit was on: the row goes too.
stale=0
while IFS= read -r file; do
  [ -z "$file" ] && continue
  if ! grep -qxF "$file" <<< "$changed"; then
    printf '  STALE       %s  (named in stemcells/seams.md, same as upstream: drop it there)\n' "$file"
    stale=1
  fi
done < <(grep -E '^\| *`' stemcells/seams.md | cut -d'|' -f2 | grep -oE '`[^`]+`' | tr -d '`' | sort -u)

lines=$(git diff --numstat "$base" -- $(echo "$changed") 2>/dev/null | awk '{s+=$1+$2} END {print s+0}')
echo "$(echo "$changed" | grep -c . || true) upstream files changed, $lines lines; $hot hot"
[ "$unlisted" = 0 ] && [ "$stale" = 0 ]
