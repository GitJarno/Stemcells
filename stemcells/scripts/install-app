#!/usr/bin/env bash
# Builds Stemcells from this checkout and installs it as Stemcells.app.
# stemcells/docs/install.md explains each step.
#
#   stemcells/scripts/install-app [--pull] [--to <folder>] [--force]
#
#   --pull     update to the latest main first
#   --to       install into <folder> instead of /Applications
#   --force    replace a different app that sits at <folder>/Stemcells.app
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

BUNDLE_ID="sh.stemcells.app"
dest_dir="/Applications"
pull=0
force=0
while [ $# -gt 0 ]; do
  case "$1" in
    --pull) pull=1 ;;
    --force) force=1 ;;
    --to) dest_dir="${2:?--to needs a folder}"; shift ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "install-app: unknown option $1" >&2; exit 2 ;;
  esac
  shift
done

fail() { echo "install-app: $1" >&2; [ -n "${2:-}" ] && echo "  fix: $2" >&2; exit 1; }
step() { echo "==> $1"; }

# 1. What the build needs. Nothing is installed for you.
[ "$(uname -s)" = "Darwin" ] || fail "Stemcells installs on macOS only."
case "$(uname -m)" in
  arm64) arch=arm64; rust_target=aarch64-apple-darwin ;;
  x86_64) arch=x64; rust_target=x86_64-apple-darwin ;;
  *) fail "unsupported processor $(uname -m)." ;;
esac
[ -x "$HOME/.cargo/bin/cargo" ] && PATH="$HOME/.cargo/bin:$PATH"
xcode-select -p >/dev/null 2>&1 || fail "Xcode Command Line Tools are missing." "xcode-select --install"
command -v node >/dev/null || fail "Node.js is missing." "install Node.js 24 from https://nodejs.org (or: brew install node@24)"
node_major=$(node -p 'process.versions.node.split(".")[0]')
[ "$node_major" -ge 24 ] || fail "Node.js $node_major is too old; 24 or newer is needed." "install Node.js 24 from https://nodejs.org"
command -v pnpm >/dev/null || fail "pnpm is missing." "corepack enable pnpm"
command -v cargo >/dev/null || fail "Rust is missing." "install it from https://rustup.rs, then: rustup target add $rust_target"
rustup target list --installed 2>/dev/null | grep -qx "$rust_target" ||
  fail "Rust can't build for this Mac yet." "rustup target add $rust_target"
free_kb=$(df -k . | awk 'NR==2 {print $4}')
[ "$free_kb" -ge $((5 * 1024 * 1024)) ] || fail "less than 5 GB free on this disk." "free some space, then run again"

dest="$dest_dir/Stemcells.app"
if [ -e "$dest" ] && [ "$force" = 0 ]; then
  existing=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$dest/Contents/Info.plist" 2>/dev/null || echo "unknown")
  [ "$existing" = "$BUNDLE_ID" ] ||
    fail "$dest is another app ($existing), not Stemcells." "move it away, or run again with --force to replace it"
fi

# 2. Optionally take the latest main.
if [ "$pull" = 1 ]; then
  step "Updating to the latest main"
  [ -z "$(git status --porcelain --untracked-files=no)" ] || fail "this checkout has uncommitted changes." "commit or set them aside, then run again"
  git switch -q main
  git pull -q --ff-only
fi

# 3–4. Dependencies as locked, then the app for this processor.
step "Installing dependencies"
pnpm install --frozen-lockfile
step "Building Stemcells for $arch (a few minutes)"
stemcells/scripts/build-scroll-phases --force
rm -rf release
pnpm exec node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch "$arch"
zip=$(ls -t release/*-"$arch".zip 2>/dev/null | head -1)
[ -n "$zip" ] || fail "the build made no app archive in release/."
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
ditto -x -k "$zip" "$stage"
[ -d "$stage/Stemcells.app" ] || fail "the archive holds no Stemcells.app."

# 5. Swap it in: quit the running copy, keep the old one in the Trash.
if pgrep -f "$dest/Contents/MacOS/" >/dev/null 2>&1; then
  step "Quitting the running Stemcells"
  osascript -e "tell application id \"$BUNDLE_ID\" to quit" >/dev/null 2>&1 || true
  for _ in $(seq 1 30); do pgrep -f "$dest/Contents/MacOS/" >/dev/null 2>&1 || break; sleep 1; done
  pgrep -f "$dest/Contents/MacOS/" >/dev/null 2>&1 && fail "Stemcells didn't quit." "quit it yourself, then run again"
fi
mkdir -p "$dest_dir"
if [ -e "$dest" ]; then
  trashed="$HOME/.Trash/Stemcells $(date '+%Y-%m-%d %H.%M.%S').app"
  step "Moving the old copy to the Trash"
  mv "$dest" "$trashed"
fi
step "Installing to $dest"
ditto "$stage/Stemcells.app" "$dest"

# 6. Open it.
open "$dest"
echo "Stemcells is installed at $dest."
